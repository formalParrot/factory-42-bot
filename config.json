{
  "adminRoleId": "YOUR_ADMIN_ROLE_ID",
  "services": [
    {
      "name": "Velocity",
      "tmuxSession": "velocity",
      "cwd": "/home/mc/velocity",
      "startCommand": "java -Xms512M -Xmx1G -jar velocity.jar",
      "stopConsoleCommand": "shutdown",
      "ping": { "host": "127.0.0.1", "port": 25565 }
    },
    {
      "name": "Minecraft Server",
      "tmuxSession": "mcserver",
      "cwd": "/home/mc/server",
      "startCommand": "java -Xms2G -Xmx4G -jar paper.jar nogui",
      "stopConsoleCommand": "stop",
      "ping": { "host": "127.0.0.1", "port": 25566 }
    }
  ]
}
