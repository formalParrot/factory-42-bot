DISCORD_TOKEN=your-bot-token
# Optional: register commands in a single guild for instant availability
GUILD_ID=

# Proxmox panel API for the System embed (uptime / CPU / RAM)
API_BASE_URL=https://panel.awdevhardware.org/api
PANEL_TOKEN=pvd_k_your-key

# Console API: authenticated HTTP + WebSocket under /f42 (server console access)
API_HOST=127.0.0.1
API_PORT=8080
API_TOKEN=generate-a-secret
# Header name carrying the token (defaults to x-api-key)
# API_HEADER=x-api-key
# Webhook token: read-only, can only GET /f42/services/:name (single-service status).
# Unlike API_TOKEN it cannot list services, read the console, run commands, start/stop
# or open a WebSocket. Optional; if unset the endpoint just requires API_TOKEN.
# WEBHOOK_TOKEN=generate-a-secret
# Header name carrying the webhook token (defaults to x-webhook-token)
# WEBHOOK_HEADER=x-webhook-token

# Set to 1 if the API sits behind a reverse proxy. The proxy's
# x-forwarded-for is then trusted as the client IP for the whitelist rate limit
# (leave unset when exposed directly, or clients can spoof the header).
# TRUST_PROXY=1
# Whitelist requests per IP per hour on the public POST /f42/whitelist/request
# endpoint (minimum 1, default 5).
# WHITELIST_REQUESTS_PER_HOUR=5

# Custom API to POST to when a server starts or stops (JSON: { service, message })
START_STOP_WEBHOOK_URL=https://api.justparrot.me/admin/notifications/
START_STOP_WEBHOOK_TOKEN=
# Header name carrying the token (defaults to x-admin-key)
# START_STOP_WEBHOOK_HEADER=x-admin-key
