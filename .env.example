DISCORD_TOKEN=your-bot-token
# Optional: register commands in a single guild for instant availability
GUILD_ID=

# Proxmox panel API for the System embed (uptime / CPU / RAM)
API_BASE_URL=https://panel.awdevhardware.org/api
PANEL_TOKEN=pvd_k_your-key

# Console API: authenticated HTTP + WebSocket under /f42 (server console access)
API_HOST=127.0.0.1
API_PORT=8080
API_TOKEN=generate-a-secret
# Header name carrying the token (defaults to x-api-key)
# API_HEADER=x-api-key

# Custom API to POST to when a server starts or stops (JSON: { service, message })
START_STOP_WEBHOOK_URL=https://api.justparrot.me/admin/notifications/
START_STOP_WEBHOOK_TOKEN=
# Header name carrying the token (defaults to x-admin-key)
# START_STOP_WEBHOOK_HEADER=x-admin-key
